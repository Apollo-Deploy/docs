                "pages": [
                  "GET /v1/projects/{projectId}/contact-properties",
                  "GET /v1/projects/{projectId}/contact-properties/{propertyId}",
                  "POST /v1/projects/{projectId}/contact-properties",
                  "PATCH /v1/projects/{projectId}/contact-properties/{propertyId}",
                  "DELETE /v1/projects/{projectId}/contact-properties/{propertyId}"
                ]
              },
              {
                "group": "Segments",
                "pages": [
                  "GET /v1/projects/{projectId}/segments",
                  "GET /v1/projects/{projectId}/segments/{segmentId}",
                  "GET /v1/projects/{projectId}/segments/{segmentId}/contacts",
                  "POST /v1/projects/{projectId}/segments",
                  "DELETE /v1/projects/{projectId}/segments/{segmentId}"
                ]
              },
              {
                "group": "Topics",
                "pages": [
                  "GET /v1/projects/{projectId}/topics",
                  "GET /v1/projects/{projectId}/topics/{topicId}",
                  "GET /v1/projects/{projectId}/topics/{topicId}/contacts",
                  "POST /v1/projects/{projectId}/topics",
                  "PATCH /v1/projects/{projectId}/topics/{topicId}",
                  "DELETE /v1/projects/{projectId}/topics/{topicId}"
                ]
              },
              {
                "group": "Suppressions",
                "pages": [
                  "GET /v1/projects/{projectId}/suppressions",
                  "GET /v1/projects/{projectId}/suppressions/export",
                  "POST /v1/projects/{projectId}/suppressions",
                  "DELETE /v1/projects/{projectId}/suppressions/{email}",
                  "POST /v1/projects/{projectId}/suppressions/import"
                ]
              },
              {
                "group": "Webhooks",
                "pages": [
                  "GET /v1/projects/{projectId}/webhooks",
                  "GET /v1/projects/{projectId}/webhooks/{endpointId}",
                  "GET /v1/projects/{projectId}/webhooks/{endpointId}/deliveries",
                  "GET /v1/projects/{projectId}/webhooks/{endpointId}/deliveries/{deliveryId}",
                  "POST /v1/projects/{projectId}/webhooks",
                  "PATCH /v1/projects/{projectId}/webhooks/{endpointId}",
                  "DELETE /v1/projects/{projectId}/webhooks/{endpointId}",
                  "POST /v1/projects/{projectId}/webhooks/{endpointId}/test",
                  "POST /v1/projects/{projectId}/webhooks/{endpointId}/replay/{deliveryId}"
                ]
              },
              {
                "group": "API key usage",
                "pages": [
                  "GET /v1/projects/{projectId}/api-keys",
                  "GET /v1/projects/{projectId}/api-keys/{keyId}",
                  "GET /v1/projects/{projectId}/api-keys/{keyId}/usage",
                  "GET /v1/projects/{projectId}/api-keys/{keyId}/usage/export"
                ]
              }
            ]
          },
          {
            "tab": "Knowledge base",
            "groups": [
              {
                "group": "Start here",
                "pages": [
                  "signal/knowledge-base/introduction",
                  "signal/knowledge-base/projects-regions-and-data-boundaries",
                  "signal/knowledge-base/account-quotas-and-limits"
                ]
              },
              {
                "group": "Sending and delivery",
                "pages": [
                  "signal/knowledge-base/accepted-vs-delivered",
                  "signal/knowledge-base/email-statuses",
                  "signal/knowledge-base/recipients-audiences-and-batches",
                  "signal/knowledge-base/scheduling-and-cancellation",
