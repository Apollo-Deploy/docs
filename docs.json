            ]
          }
        ]
      }
    ],
    "global": {
      "anchors": [
        {
          "anchor": "Marketing site",
          "href": "https://apollodeploy.com",
          "icon": "house"
        },
        {
          "anchor": "Support",
          "href": "mailto:support@apollodeploy.com",
          "icon": "life-ring"
        }
      ]
    }
  },
  "redirects": [
    {
      "source": "/",
      "destination": "/signal",
      "permanent": false
    },
    {
      "source": "/quickstart",
      "destination": "/deploy/quickstart",
      "permanent": false
    },
    {
      "source": "/signal/quickstart",
      "destination": "/signal/getting-started/dashboard-quickstart",
      "permanent": false
    },
    {
      "source": "/signal/webhooks",
      "destination": "/signal/webhooks/introduction",
      "permanent": false
    },
    {
      "source": "/signal/sandbox",
      "destination": "/signal/dashboard/emails/send-test-emails",
      "permanent": false
    }
  ],
  "contextual": {
    "options": ["copy", "view", "chatgpt", "claude", "cursor", "vscode"]
  },
  "interaction": {
    "drilldown": false
  }
}
