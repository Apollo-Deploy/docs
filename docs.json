              },
              {
                "group": "Domains and DNS",
                "pages": [
                  "signal/knowledge-base/dns-record-reference",
                  "signal/knowledge-base/what-if-domain-not-verifying",
                  "signal/knowledge-base/automatic-dns-setup",
                  "signal/knowledge-base/cloudflare",
                  "signal/knowledge-base/subdomain-vs-root-domain",
                  "signal/knowledge-base/domain-regions",
                  "signal/knowledge-base/tracking-domain-and-link-tracking",
                  "signal/knowledge-base/dmarc-and-reporting",
                  "signal/knowledge-base/bimi",
                  "signal/knowledge-base/avoid-spam-folder"
                ]
              },
              {
                "group": "Contacts and consent",
                "pages": [
                  "signal/knowledge-base/contacts-and-properties",
                  "signal/knowledge-base/segments",
                  "signal/knowledge-base/topics-and-subscriptions",
                  "signal/knowledge-base/suppressions"
                ]
              },
              {
                "group": "Webhooks and observability",
                "pages": [
                  "signal/knowledge-base/webhook-events",
                  "signal/knowledge-base/webhook-signatures",
                  "signal/knowledge-base/webhook-retries-and-replays",
                  "signal/knowledge-base/metrics-and-engagement",
                  "signal/knowledge-base/audit-logs-and-api-key-usage"
