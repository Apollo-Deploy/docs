              },
              {
                "group": "Insights",
                "pages": [
                  "signal/dashboard/metrics/introduction",
                  "signal/dashboard/dmarc/introduction",
                  "signal/dashboard/logs/introduction"
                ]
              },
              {
                "group": "Domains",
                "pages": [
                  "signal/dashboard/domains/introduction",
                  "signal/dashboard/domains/dmarc",
                  "signal/dashboard/domains/bimi",
                  "signal/dashboard/domains/tracking",
                  "signal/dashboard/domains/regions",
                  "signal/dashboard/domains/domain-connect"
                ]
              },
              {
                "group": "Webhooks",
                "pages": [
                  "signal/webhooks/introduction",
                  "signal/dashboard/webhooks/introduction",
                  "signal/webhooks/event-types",
                  "signal/webhooks/verify-webhooks-requests",
                  "signal/webhooks/retries-and-replays"
                ]
              },
              {
                "group": "Settings",
                "pages": [
                  "signal/dashboard/api-keys/introduction",
                  "signal/dashboard/settings/project",
                  "signal/dashboard/settings/usage",
                  "signal/dashboard/settings/smtp"
                ]
              },
              {
                "group": "Migration",
                "pages": [
                  "signal/migration/introduction",
                  "signal/migration/providers"
                ]
              }
            ]
          },
          {
            "tab": "API Reference",
            "openapi": "signal/api-reference/openapi.json",
            "groups": [
              {
                "group": "Overview",
                "pages": [
                  "signal/api-reference/introduction",
                  "signal/api-reference/authentication",
                  "signal/api-reference/errors",
                  "signal/api-reference/pagination",
                  "signal/api-reference/idempotency",
                  "signal/api-reference/event-streams",
                  "signal/api-reference/rate-limit"
                ]
              },
              {
                "group": "Emails",
                "pages": [
                  "POST /v1/emails",
                  "GET /v1/emails/{emailId}",
                  "POST /v1/emails/batch",
                  "DELETE /v1/emails/{emailId}",
                  "DELETE /v1/emails",
                  "POST /v1/emails/{projectId}/stream/token",
                  "GET /v1/emails/stream",
                  "POST /v1/emails/validate"
                ]
              },
              {
                "group": "Metrics",
                "pages": [
                  "GET /v1/metrics/topics/{id}",
                  "GET /v1/metrics/emails/{id}",
                  "GET /v1/metrics/emails/{id}/engagement",
                  "GET /v1/metrics/summary",
                  "GET /v1/metrics/timeline",
                  "GET /v1/metrics/advisor"
                ]
              },
              {
                "group": "Projects and email logs",
                "pages": [
                  "GET /v1/projects",
