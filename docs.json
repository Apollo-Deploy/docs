{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "luma",
  "name": "Apollo Deploy",
  "description": "Documentation for Apollo Deploy and Apollo Signal — release intelligence and transactional email for developers.",
  "colors": {
    "primary": "#171717",
    "light": "#e8e4d9",
    "dark": "#171717"
  },
  "appearance": {
    "default": "system",
    "strict": false
  },
  "background": {
    "color": {
      "light": "#ffffff",
      "dark": "#000000"
    }
  },
  "fonts": {
    "family": "Geist",
    "heading": {
      "family": "Geist",
      "weight": 500
    },
    "body": {
      "family": "Geist",
      "weight": 400
    }
  },
  "styling": {
    "eyebrows": "section",
    "codeblocks": "dark"
  },
  "favicon": {
    "light": "/favicons/signal/favicon.png",
    "dark": "/favicons/signal/favicon-dark.png"
  },
  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg",
    "href": "https://apollodeploy.com"
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Get started",
      "href": "https://auth.apollodeploy.com/register"
    }
  },
  "navigation": {
    "products": [
      {
        "product": "Apollo Deploy",
        "description": "Release intelligence control plane",
        "icon": "rocket",
        "groups": [
          {
            "group": "Getting started",
            "pages": ["deploy/index", "deploy/quickstart"]
          }
        ]
      },
      {
        "product": "Packages",
        "description": "Reusable utilities and components",
        "icon": "box",
        "groups": [
          {
            "group": "Utilities",
            "pages": ["packages/time", "packages/user-agent"]
          }
        ]
      },
      {
        "product": "Apollo Signal",
        "description": "Transactional email for developers",
        "icon": "/logo/signal/icon.svg",
        "tabs": [
          {
            "tab": "Documentation",
            "groups": [
              {
                "group": "Getting started",
                "pages": [
                  "signal/index",
                  "signal/getting-started/dashboard-quickstart",
                  "signal/create-an-api-key",
                  "signal/add-a-domain",
                  {
                    "group": "Send with",
                    "expanded": false,
                    "icon": "code",
                    "pages": [
                      "signal/send-with/sdk-overview",
                      "signal/send-with/send-with-nodejs",
                      "signal/send-with/send-with-nextjs",
                      "signal/send-with/send-with-express",
                      "signal/send-with/send-with-python",
                      "signal/send-with/send-with-go",
                      "signal/send-with/send-with-ruby",
                      "signal/send-with/send-with-rails",
                      "signal/send-with/send-with-php",
                      "signal/send-with/send-with-laravel",
                      "signal/send-with/send-with-java",
                      "signal/send-with/send-with-kotlin",
                      "signal/send-with/send-with-dotnet",
                      "signal/send-with/send-with-rust",
                      "signal/send-with/send-with-elixir",
                      "signal/send-with/send-with-swift",
                      "signal/send-with/send-with-zig",
                      "signal/send-with/send-with-smtp",
                      "signal/send-with/send-with-rest"
                    ]
                  }
                ]
              },
              {
                "group": "Dashboard",
                "pages": [
                  "signal/dashboard/overview/introduction",
                  "signal/dashboard/projects/introduction"
                ]
              },
              {
                "group": "Emails",
                "pages": [
                  "signal/dashboard/emails/introduction",
                  "signal/dashboard/emails/send-from-dashboard",
                  "signal/dashboard/emails/batch-sending",
                  "signal/dashboard/emails/schedule-email",
                  "signal/dashboard/emails/send-test-emails",
                  "signal/dashboard/emails/attachments",
                  "signal/dashboard/emails/idempotency-keys"
                ]
              },
              {
                "group": "Contacts and consent",
                "pages": [
                  "signal/dashboard/audiences/introduction",
                  "signal/dashboard/properties/introduction",
                  "signal/dashboard/segments/introduction",
                  "signal/dashboard/topics/introduction",
                  "signal/dashboard/suppressions/introduction"
